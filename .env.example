# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Dataset paths (already present at project root, do not move them) ---
PHYSIONET_RAW_PATH=./physionet/challenge-2019-1.0.0/training
MIMIC_IV_RAW_PATH=./mimic-iv-clinical-database-demo-2.2

# --- Processed data output ---
PROCESSED_DATA_PATH=./data/processed

# --- MongoDB (used from Step 7 onward) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sepsis_icu

# --- MQTT (used from Step 8/11 onward) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Alerting (used from Step 10 onward) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- API (used from Step 8 onward) ---
API_SECRET_KEY=change_me_in_production
LOG_LEVEL=INFO

# --- Alert module (used from Step 10 onward) ---
ALERT_TRIGGER_RISK_LEVELS=High,Critical
ALERT_COOLDOWN_MINUTES=30

# --- Dashboard (used from Step 9 onward) ---
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DASHBOARD_SECRET_KEY=change_me_in_production
LIVE_MONITORING_POLL_SECONDS=5.0
